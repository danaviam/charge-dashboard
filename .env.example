VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ADMIN_PASSWORD=your_admin_password

# Server-side only — set in Vercel dashboard → Settings → Environment Variables (never VITE_ prefix)
# Resend API key — used by api/notify-reading.ts
RESEND_API_KEY=re_xxxxxxxxxxxx
# Supabase service role key — used by api/db/*.ts to bypass RLS for writes
# Find it in Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
